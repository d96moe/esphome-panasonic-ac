esphome:
  name: panasonic-ac

esp32:
  board: nodemcu-32s

wifi:
  networks:
  ap: {}

logger:
  level: DEBUG
#  baud_rate: 0 # ESP8266 only

api:

ota:
  platform: esphome

# Requires ESPHome 1.15.0+ for the even parity option
uart:
  tx_pin: GPIO17
  rx_pin: GPIO16
  baud_rate: 9600
  parity: EVEN

external_components:
  source: github://DomiStyle/esphome-panasonic-ac
  components: [panasonic_ac]


climate:
  - platform: panasonic_ac
    # For CZ-TACG1
    # type: cnt

    # For DNSK-P11
    # type: wlan

    name: Panasonic AC
    horizontal_swing_select:
      name: Panasonic AC Horizontal Swing Mode
    vertical_swing_select:
      name: Panasonic AC Vertical Swing Mode
    outside_temperature:
      name: Panasonic AC Outside Temperature

    # DNSK-P11 only: exposes the AC error/status code (e.g. "H000" = OK).
    # Reported in every poll → passive fault detection without sending commands.
    # error_code:
    #   name: Panasonic AC Error Code
    #   id: panasonic_ac_error_code

    # Enable as needed
    # eco_switch:
    #   name: Panasonic AC Eco Switch
    # econavi_switch:
    #   name: Panasonic AC Econavi Switch
    # nanoex_switch:
    #   name: Panasonic AC NanoeX Switch
    # mild_dry_switch:
    #   name: Panasonic AC Mild Dry Switch
    # current_power_consumption:
    #   name: Panasonic AC Power Consumption

    # Adapt according to your measurements
    # current_temperature_offset: 0
    # outside_temperature_offset: 0

    # Useful when the ac does not report a current temperature (CZ-TACG1 only)
    # current_temperature_sensor: temperature_sensor_id

    # ----------------------------------------------------------------------
    # Protocol-investigation debug sensors (DNSK-P11 / type: wlan only).
    # Pure RX taps that publish raw hex of packets the normal flow ignores,
    # for offline analysis (e.g. finding the live compressor/working-mode byte).
    # They never change what is sent to the AC. See protocol/INVESTIGATION.md.
    # raw_packet:
    #   name: Panasonic AC Raw Packet            # 0x89 poll response
    # debug_telemetry_1:
    #   name: Panasonic AC Debug Telemetry 1     # 0x11 0x03 telemetry bytes 0..124
    # debug_telemetry_2:
    #   name: Panasonic AC Debug Telemetry 2     # 0x11 0x03 telemetry bytes 125..end
    # debug_report:
    #   name: Panasonic AC Debug Report          # 0x10 0x0A report (pushed on state change)
    # debug_unknown:
    #   name: Panasonic AC Debug Unknown         # otherwise-dropped packets (incl. 0x3A header)

    # Phase B (DORMANT): append ONE extra read key to the poll request so its
    # echoed value lands in raw_packet. Polling is a read (never writes AC state).
    # Activate one key at a time, under supervision. Omit for default polling.
    # probe_key: 0x00
